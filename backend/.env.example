# ===================================================
# SupportDesk Backend Environment Configuration
# ===================================================

# AI Service Provider: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Gemini Model override (default is gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (optional alternative)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
